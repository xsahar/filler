# Build a Linux player binary from this Rust project.
FROM rust:1.77-bookworm AS builder
WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY tests ./tests

RUN cargo build --release

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=builder /app/target/release/filler /app/filler
RUN chmod +x /app/filler
ENTRYPOINT ["/app/filler"]
